# Copy this file to .env and fill in real values.

# AI providers
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Gemini relay
# GEMINI_API_KEY=your_gemini_relay_key_here
# GEMINI_MASTER_MODEL=gemini-3.1-pro

# Embeddings for local vector memory
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDINGS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_MODEL=your_embedding_model_id_here

# Feature flags
ENABLE_MCP_BAZI=true
ENABLE_MCP_ZIWEI=false
ENABLE_SHARED_MEMORY=true
ENABLE_VECTOR_MEMORY=true
ENABLE_ASYNC_ORGANIZER=true

# Bazi provider: auto, local, or mcp
BAZI_CALC_PROVIDER=auto
ENABLE_AI_CHART_FACTS_SUMMARY=false

# Flask server
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your_secret_key_here
HOST=0.0.0.0
PORT=5000

# Local storage
LOCAL_DATA_DIR=local_data
BAZI_DATA_DIR=local_data/bazi_data
ANALYSIS_DATA_DIR=local_data/analysis_data
SESSIONS_DIR=local_data/sessions

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Session and rate limits
SESSION_TIMEOUT=3600
MAX_USERS=100
RATE_LIMIT=60

# Production example
# FLASK_ENV=production
# FLASK_DEBUG=false
# LOG_LEVEL=WARNING
